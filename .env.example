# Sentinel Flash — server-side environment.
# Never expose these to the browser. Never use VITE_ prefixes for secrets.

# Google Gemini API key (server-side only).
GEMINI_API_KEY=

# Optional: Lovable AI Gateway key, used as the Gemini transport when
# GEMINI_API_KEY is not configured. Managed by the platform.
LOVABLE_API_KEY=
